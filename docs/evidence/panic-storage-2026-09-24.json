      "script": "import assert from 'node:assert/strict';\nimport { createRequire } from 'node:module';\nimport { createReadStream, existsSync, readFileSync, writeFileSync } from 'node:fs';\nimport { createHash } from 'node:crypto';\nimport { resolve } from 'node:path';\nimport { ensureResourceGuard } from '../scripts/full-lean/resource-guard.mjs';\nawait ensureResourceGuard();\nconst require = createRequire(import.meta.url);\nconst cache = require('../.cache/js-runtimes/node-26.10.0/lib/node_modules/npm/node_modules/cacache');\nconst directory = resolve('.cache/npm/_cacache'), output = '.work/product-acceptance/verified-npm-tarball-reclamation-r2.json';\nassert.ok(!existsSync(output));\nasync function hash(path, algorithm, encoding='hex') {\n const h=createHash(algorithm); for await(const bytes of createReadStream(path)) h.update(bytes); return h.digest(encoding);\n}\nconst all=await cache.ls(directory), candidates=[], absent=[];\nfor(let n=2;n<=11;n++) {\n const receipt=JSON.parse(readFileSync(`.work/application-package-r${n}/result.json`));\n assert.equal(await hash(receipt.tarball,'sha256'),receipt.sha256);\n const integrity='sha512-'+await hash(receipt.tarball,'sha512','base64');\n const entries=Object.values(all).filter(e=>e.integrity===integrity);\n assert.ok(entries.length>0);\n for(const e of entries) {\n  assert.ok(e.key.startsWith('pacote:tarball:file:') && e.key.includes('application-package-r'+n+'/'));\n  assert.equal(e.size,receipt.compressedBytes);\n }\n if(!existsSync(entries[0].path)) { absent.push({retainedArchive:receipt.tarball,integrity,scope:'Stale npm index; no content removed'}); continue; }\n assert.equal(await hash(entries[0].path,'sha256'),receipt.sha256);\n candidates.push({retainedArchive:receipt.tarball,sha256:receipt.sha256,integrity,bytes:receipt.compressedBytes,\n  entries,phase:'verified'});\n}\nconst report={scope:'Remove only disposable npm cache copies whose complete bytes match retained local package tarballs',\n resourceReport:process.env.LASM_RESOURCE_REPORT,restore:'Reinstall from the recorded local tarball; npm repopulates its cache. No retained tarball or application evidence is removed.',files:candidates,alreadyAbsent:absent};\nconst save=()=>writeFileSync(output,JSON.stringify(report,null,2)+'\\n');save();\nfor(const row of candidates) {\n for(const e of row.entries) assert.equal((await cache.get.info(directory,e.key)).integrity,row.integrity);\n assert.equal(await hash(row.retainedArchive,'sha256'),row.sha256);\n for(const e of row.entries) await cache.rm.entry(directory,e.key);\n await cache.rm.content(directory,row.integrity);\n assert.equal(await cache.get.hasContent(directory,row.integrity),false);\n row.phase='cache copies removed';save();\n}\nreport.savedBytes=candidates.reduce((n,r)=>n+r.bytes,0);report.finishedAt=new Date().toISOString();save();\nconsole.log(JSON.stringify({verifiedArchives:candidates.length,savedBytes:report.savedBytes}));\n"

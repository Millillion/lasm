      "script": "\"\"\"Share identical completed gzip files, preserving every archive path and byte.\"\"\"\nfrom pathlib import Path\nimport collections\nimport datetime\nimport hashlib\nimport json\nimport os\nimport resource\nimport stat\n\nresource.setrlimit(resource.RLIMIT_AS, (256 * 1024**2, 256 * 1024**2))\nroot = Path.cwd()\ngroup = Path('/sys/fs/cgroup') / Path('/proc/self/cgroup').read_text().strip().split('::', 1)[1].lstrip('/')\nassert group.name == os.environ['LASM_RESOURCE_UNIT']\nassert 0 < int((group / 'memory.max').read_text()) <= 2 * 1024**3\nassert (group / 'memory.high').read_text().strip() == 'max'\noutput = root / '.work/product-acceptance/completed-float-archive-deduplication-r1.json'\nassert not output.exists()\n\ndef sha(path):\n    with path.open('rb') as stream:\n        digest = hashlib.file_digest(stream, 'sha256').hexdigest()\n        os.posix_fadvise(stream.fileno(), 0, 0, os.POSIX_FADV_DONTNEED)\n        return digest\n\ngroups = collections.defaultdict(list)\nprovenance = []\nfor name in ['upstream-float-2026-09-24']:\n    evidence = root / 'docs/evidence' / (name + '.json')\n    receipt = json.loads(evidence.read_text())\n    provenance.append({'file': str(evidence.relative_to(root)), 'sha256': sha(evidence)})\n    for case in receipt['results']:\n        assert case.get('passed', case.get('result', {}).get('passed')) is True\n        for key in ['resources', 'archiveResources']:\n            guard = case[key]\n            assert guard['unitReleased'] and not guard['resourceLimited'] and guard['result']['code'] == 0\n        for row in case['archive']['files']:\n            assert row['phase'] == 'archived' and row['verifiedDecompression']\n            path = Path(row['archive'])\n            assert path.is_relative_to(root / '.work') and not path.is_symlink()\n            metadata = path.stat()\n            assert stat.S_ISREG(metadata.st_mode) and metadata.st_nlink == 1\n            assert metadata.st_size == row['archiveBytes'] and sha(path) == row['archiveSha256']\n            groups[(row['archiveSha256'], row['archiveBytes'])].append(path)\n\nassert sum(len(paths) for paths in groups.values()) == 9\nreport = {'scope': 'Deduplication of byte-identical completed gzip archives only; all original archive paths and decoded bytes remain recoverable',\n          'resourceReport': os.environ['LASM_RESOURCE_REPORT'], 'sourceEvidence': provenance, 'files': [],\n          'restore': 'Archives share immutable storage. Use gzip -dc ARCHIVE > ORIGINAL; verify the original hash and restore mode/mtime from the source evidence. Never rewrite an archive in place.'}\n\ndef save():\n    output.write_text(json.dumps(report, indent=2) + '\\n')\n\nsave()\nfor (digest, size), paths in groups.items():\n    canonical = paths[0]\n    for path in paths[1:]:\n        assert sha(canonical) == sha(path) == digest\n        original = path.stat()\n        temporary = Path(str(path) + '.deduplicating')\n        assert not temporary.exists() and canonical.stat().st_dev == original.st_dev\n        os.link(canonical, temporary)\n        assert os.path.samefile(canonical, temporary) and sha(temporary) == digest\n        os.replace(temporary, path)\n        assert os.path.samefile(canonical, path) and path.stat().st_size == size and sha(path) == digest\n        report['files'].append({'archive': str(path), 'sharedWith': str(canonical), 'sha256': digest,\n                                'bytes': size, 'releasedAllocatedBytes': original.st_blocks * 512})\n        save()\nreport['savedAllocatedBytes'] = sum(row['releasedAllocatedBytes'] for row in report['files'])\nreport['finishedAt'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\nsave()\nprint(json.dumps({'pathsPreserved': 9, 'duplicatesShared': len(report['files']), 'savedAllocatedBytes': report['savedAllocatedBytes']}))\n"

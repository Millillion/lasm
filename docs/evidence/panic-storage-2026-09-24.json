      "script": "\"\"\"Losslessly archive completed experiment binaries after byte verification.\"\"\"\nimport datetime\nimport gzip\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport resource\nimport shutil\n\nresource.setrlimit(resource.RLIMIT_AS, (256 * 1024**2, 256 * 1024**2))\nroot = Path.cwd()\ngroup = Path('/sys/fs/cgroup') / Path('/proc/self/cgroup').read_text().strip().split('::', 1)[1].lstrip('/')\nassert group.name == os.environ['LASM_RESOURCE_UNIT']\nassert 0 < int((group / 'memory.max').read_text()) <= 10 * 1024**3\nassert (group / 'memory.high').read_text().strip() == 'max'\nrecord_file = root / '.work/product-acceptance/completed-wasmtime-archive-r1.json'\nassert not record_file.exists()\ndef sha(path):\n    with path.open('rb') as stream:\n        digest = hashlib.file_digest(stream, 'sha256').hexdigest()\n        os.posix_fadvise(stream.fileno(), 0, 0, os.POSIX_FADV_DONTNEED)\n        return digest\nevidence = root / 'docs/evidence/wasmtime-real-lean-compilation-2026-09-24.json'\nresult = root / '.work/wasmtime-lean-compilation-r4/result.json'\nr = json.loads(result.read_text())\nguard = json.loads(Path(r['resourceReport']).read_text())\nassert guard['unitReleased'] and guard['result']['code'] == 0 and not guard['resourceLimited']\ncompiled = root / '.work/wasmtime-lean-compilation-r4/compiled.cwasm'\nexpected = r['cache']['sha256']\nassert sha(compiled) == expected\nassert expected in evidence.read_text()\ninputs = [(compiled, expected, {'committedEvidence': str(evidence.relative_to(root)), 'receiptSha256': sha(evidence)})]\n\n# Establish every input before changing any completed artifact.\nfor path, expected, _ in inputs:\n    assert path.is_relative_to(root / '.work') and path.is_file() and not path.is_symlink()\n    assert sha(path) == expected\n    assert not Path(str(path) + '.gz').exists()\n\nreport = {'scope': 'Lossless archival of completed generated evidence only; originals recoverable byte-for-byte',\n          'resourceReport': os.environ.get('LASM_RESOURCE_REPORT'), 'files': [],\n          'restore': 'Decompress each archive to its original path, verify originalSha256, then restore mode and mtimeNs from this receipt.'}\ndef save():\n    record_file.write_text(json.dumps(report, indent=2) + '\\n')\n\nfor path, expected, provenance in inputs:\n    stat = path.stat()\n    archive = Path(str(path) + '.gz')\n    partial = Path(str(archive) + '.partial')\n    with path.open('rb') as source, partial.open('xb') as raw:\n        with gzip.GzipFile(filename='', mode='wb', fileobj=raw, compresslevel=1, mtime=0) as dest:\n            shutil.copyfileobj(source, dest, 1024 * 1024)\n        raw.flush()\n        os.fsync(raw.fileno())\n    with gzip.open(partial, 'rb') as stream:\n        digest = hashlib.sha256()\n        length = 0\n        while block := stream.read(1024 * 1024):\n            length += len(block)\n            digest.update(block)\n    assert length == stat.st_size and digest.hexdigest() == expected\n    assert sha(path) == expected and partial.stat().st_size < stat.st_size\n    partial.rename(archive)\n    row = {'original': str(path), 'originalBytes': stat.st_size, 'originalSha256': expected,\n           'mode': stat.st_mode & 0o7777, 'mtimeNs': stat.st_mtime_ns, 'archive': str(archive),\n           'archiveBytes': archive.stat().st_size, 'archiveSha256': sha(archive),\n           'verifiedDecompression': True, 'provenance': provenance, 'phase': 'verified'}\n    report['files'].append(row)\n    save()\n    path.unlink()\n    row['phase'] = 'archived'\n    save()\n    print(json.dumps({'file': str(path.relative_to(root)), 'savedBytes': stat.st_size - archive.stat().st_size}), flush=True)\nreport['savedBytes'] = sum(row['originalBytes'] - row['archiveBytes'] for row in report['files'])\nreport['finishedAt'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\nsave()\n"

  "diagnosticScript": {
    "path": ".work/full-engine-probe/derive-bun-metrics.mjs",
    "sha256": "b8a1d9fbdf52beac416eaa148a6ef7887fd7a8417ba0b5558fafa330bfe93c06",
    "source": "import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync, symlinkSync, createReadStream } from 'node:fs';\nimport { resolve, join } from 'node:path';\nimport { createHash } from 'node:crypto';\nimport { ensureResourceGuard } from '../../scripts/full-lean/resource-guard.mjs';\nawait ensureResourceGuard();\nconst source = resolve('.work/full-artifacts/wasm64-v49-process-lifetime-lowered');\nconst output = resolve('.work/full-artifacts/wasm64-v54-bun-metrics');\nconst metrics = resolve('.work/full-engine-probe/bun-v54-metrics');\nif (existsSync(output) || existsSync(metrics)) throw new Error('Use fresh diagnostic outputs');\nasync function hash(path) {\n  const h = createHash('sha256');\n  for await (const bytes of createReadStream(path)) h.update(bytes);\n  return h.digest('hex');\n}\nconst metadata = JSON.parse(readFileSync(join(source, 'snapshot.json')));\nfor (const [name, expected] of Object.entries(metadata.files))\n  if (await hash(join(source, name)) !== expected) throw new Error('Frozen input changed: ' + name);\nlet glue = readFileSync(join(source, 'bin/lean.js'), 'utf8');\nconst marker = 'var getFunctionAddress = function indexedFunctionAddress(func) {';\nif (glue.split(marker).length !== 2) throw new Error('Function lookup drift');\nconst monitor = `\nvar lasmMetricDirectory = ${JSON.stringify(metrics)};\nfunction lasmEngineMemory(stage, func) {\n  var usage = process.memoryUsage();\n  var record = { at: new Date().toISOString(), stage, pid: process.pid, thread: require('node:worker_threads').threadId,\n    functionName: func?.name, usage,\n    linearBytes: typeof wasmMemory === 'undefined' ? null : wasmMemory?.buffer.byteLength,\n    tableEntries: typeof wasmTable === 'undefined' ? null : Number(wasmTable?.length) };\n  require('node:fs').appendFileSync(lasmMetricDirectory + '/' + process.pid + '.jsonl', JSON.stringify(record) + '\\\\n');\n}\nif (!ENVIRONMENT_IS_PTHREAD) {\n  var lasmMetricTimer = setInterval(() => lasmEngineMemory('main-sample'), 10000);\n  lasmMetricTimer.unref();\n}\n`;\nglue = glue.replace(marker, monitor + marker);\nconst first = '    functionsInTableMap = new WeakMap();';\nif (glue.split(first).length !== 2) throw new Error('Initial index drift');\nglue = glue.replace(first, first + '\\n    lasmEngineMemory(\"first-index\", func);');\nconst fallback = '    lasmTableMapComplete = true;\\n    updateTableMap(0, Number(wasmTable.length));';\nif (glue.split(fallback).length !== 2) throw new Error('Lookup fallback drift');\nglue = glue.replace(fallback, '    lasmEngineMemory(\"before-full-scan\", func);\\n' + fallback + '\\n    lasmEngineMemory(\"after-full-scan\", func);');\nmkdirSync(metrics);\nmkdirSync(join(output, 'bin'), { recursive: true });\nfor (const name of readdirSync(source)) {\n  if (['bin', 'snapshot.json', 'build-provenance.json'].includes(name)) continue;\n  symlinkSync(join(source, name), join(output, name));\n}\nfor (const name of readdirSync(join(source, 'bin'))) {\n  if (['lean.js', 'lean.cjs'].includes(name)) writeFileSync(join(output, 'bin', name), glue);\n  else symlinkSync(join(source, 'bin', name), join(output, 'bin', name));\n}\nconst derivation = { scope: 'Private numeric heap/linear-memory metrics and function-table scan tracing. Diagnostic run only; no test, Wasm, host, GC, or worker-count changes.',\n  metrics, wasmSha256: await hash(join(source, 'bin/lean.wasm')), scriptSha256: await hash(new URL(import.meta.url)) };\nconst provenance = JSON.parse(readFileSync(join(source, 'build-provenance.json')));\nwriteFileSync(join(output, 'build-provenance.json'), JSON.stringify({ ...provenance, memoryDiagnostic: derivation }, null, 2) + '\\n');\nObject.assign(metadata, { derivedFrom: source, createdAt: new Date().toISOString(), derivation });\nfor (const name of ['bin/lean.js', 'bin/lean.cjs', 'build-provenance.json']) metadata.files[name] = await hash(join(output, name));\nwriteFileSync(join(output, 'snapshot.json'), JSON.stringify(metadata, null, 2) + '\\n');\nconsole.log(JSON.stringify({ output, ...derivation }));\n"
  },
  "finding": "No complete function-table scan occurred in any of the three compiler processes before the 8.04 GiB budget stop. Each initialized its main instance and eight workers with the index; the file worker process also created a ninth worker before the stop.",
  "interpretation": "The previous eager table-scan defect is absent from this reproduction. Linear-memory growth and other engine/native overhead remain. RSS and Bun memoryUsage fields are observations, not disjoint allocation categories or a complete memory attribution.",
  "nextHypothesis": "Compare the ordinary three-Lean-worker CLI configuration with native Lean before adopting it. Keep Bun worker pools, any GC options, and guard limits explicit; do not treat a lower memory sample as a passing test."

  "helperSource": "from pathlib import Path\nimport datetime, hashlib, json, os, subprocess\n\nassert os.environ.get('LASM_RESOURCE_UNIT')\nroot = Path.cwd()\noutput = root / '.work/full-engine-probe/capacity-host-bridge'\nassert not output.exists()\noutput.mkdir()\nenv = {**os.environ, 'BINARYEN_CORES': '1', 'EMCC_CORES': '1', 'CMAKE_BUILD_PARALLEL_LEVEL': '1'}\n\ndef sha(path):\n    digest = hashlib.sha256()\n    with path.open('rb') as stream:\n        while chunk := stream.read(1024 * 1024):\n            digest.update(chunk)\n    return digest.hexdigest()\n\ninputs = [root / 'scripts/full-lean/probes/host-highmemory.cpp',\n          root / 'scripts/full-lean/emscripten-pre.js',\n          root / 'scripts/full-lean/host-pre.js',\n          root / 'scripts/full-lean/host-library.js', *sorted((root / 'src').glob('*.mjs')),\n          *sorted((root / 'src').glob('*.cjs'))]\nbefore = {str(path): sha(path) for path in inputs}\nengines = [\n    ('node', [str(Path('/home/lastmjs/.nvm/versions/node/v24.13.1/bin/node'))]),\n    ('deno', [str(root / '.cache/js-runtimes/deno-2.9.7/deno'), 'run', '-A']),\n    ('bun', [str(root / '.cache/js-runtimes/bun-1.4.2-memory64-capacity8g-release-2026-09-21/bun')]),\n]\nengine_hashes = {name: sha(Path(command[0])) for name, command in engines}\nassert engine_hashes['bun'] == '8199c4efa1c3217d2229bcb35f0699e3fa6946d12edde13df9f871502d26ae1a'\naudit = output / 'audit-pre.js'\naudit.write_text('''\nif (!ENVIRONMENT_IS_PTHREAD) {\n  const original = Module.lasmFullHostRequest;\n  Module.lasmFullHostRequest = function (request) {\n    if (request.signalPointer < Number(process.env.LASM_PROBE_HIGH_BASE)) {\n      console.error('Probe did not allocate its wait signal above the requested boundary');\n      process.exit(10);\n    }\n    return original(request);\n  };\n}\n''')\nrecord = {'startedAt': datetime.datetime.now(datetime.timezone.utc).isoformat(),\n          'scope': 'Actual full-runtime host RPC above 2/4 GiB, including four concurrent pthread callers; separate from upstream suite counts.',\n          'inputHashesBefore': before, 'engineHashesBefore': engine_hashes,\n          'auditSource': audit.read_text(), 'results': []}\nsummary = output / 'results.json'\ndef save():\n    summary.write_text(json.dumps(record, indent=2) + '\\n')\n\nfor label, boundary in [('small', 65536), ('above2gb', 2**31), ('above4gb', 2**32)]:\n    program = output / (label + '.cjs')\n    command = [str(root / '.cache/emsdk-6.0.9-dev/upstream/emscripten/em++'), str(inputs[0]),\n               '-O1', '-pthread', '-fwasm-exceptions', '-sMEMORY64=1',\n               '-sALLOW_MEMORY_GROWTH=1', '-sGROWABLE_ARRAYBUFFERS=1', '-sMAXIMUM_MEMORY=8589934592',\n               '-sPROXY_TO_PTHREAD=1', '-sPTHREAD_POOL_SIZE=5', '-sEXIT_RUNTIME=1',\n               f'-DLASM_HIGH_MEMORY_BASE={boundary}ULL',\n               '--pre-js', str(inputs[1]), '--pre-js', str(inputs[2]), '--pre-js', str(audit),\n               '--js-library', str(inputs[3]), '-o', str(program)]\n    log = output / (label + '-build.log')\n    with log.open('x') as stream:\n        built = subprocess.run(command, env=env, stdout=stream, stderr=subprocess.STDOUT, timeout=180)\n    item = {'label': label, 'buildCommand': command, 'buildCode': built.returncode,\n            'buildLog': str(log), 'runs': []}\n    record['results'].append(item)\n    save()\n    assert built.returncode == 0, str(log)\n    item['artifacts'] = {str(path): sha(path) for path in [program, program.with_suffix('.wasm')]}\n    for name, engine in engines:\n        run_env = {**env, 'LASM_PROBE_HIGH_BASE': str(boundary), 'LASM_PROBE_HIGH_VALUE': 'host above heap',\n                   'LASM_FULL_HOST_MODULE': (root / 'src/node-host.mjs').as_uri()}\n        if name == 'bun':\n            run_env['BUN_JSC_useWasmMemory64'] = 'true'\n        result = subprocess.run(engine + [str(program)], env=run_env, capture_output=True, text=True, timeout=90)\n        passed = result.returncode == 0 and result.stdout == 'high-memory synchronous and asynchronous host calls passed\\n' and result.stderr == ''\n        item['runs'].append({'engine': name, 'command': engine + [str(program)], 'code': result.returncode,\n                             'stdout': result.stdout, 'stderr': result.stderr, 'passed': passed})\n        save()\n        print(json.dumps({'label': label, 'engine': name, 'passed': passed}), flush=True)\n        if label == 'small':\n            assert passed, 'Small control failed; do not request larger memory'\nrecord['inputHashesAfter'] = {str(path): sha(path) for path in inputs}\nrecord['engineHashesAfter'] = {name: sha(Path(command[0])) for name, command in engines}\nrecord['inputsUnchanged'] = record['inputHashesBefore'] == record['inputHashesAfter'] and record['engineHashesBefore'] == record['engineHashesAfter']\nrecord['passed'] = record['inputsUnchanged'] and all(run['passed'] for item in record['results'] for run in item['runs'])\nrecord['finishedAt'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\nsave()\nraise SystemExit(0 if record['passed'] else 1)\n",

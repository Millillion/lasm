{
  "name": "tandem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tandem, a collaborative text editor in Lean: Fugue's sequence CRDT, a sync server and a Lasm.UI editor that works offline, compiled to WebAssembly by Lasm, with proofs",
  "scripts": {
    "build": "lasm build ServerNode.lean --output dist/server",
    "start": "node dist/server/main.mjs",
    "build:batch": "lasm build Batch.lean --output dist/batch",
    "build:clients": "lasm build Clients.lean --output dist/clients",
    "test": "node test/protocol.mjs",
    "test:differential": "node test/differential.mjs",
    "test:simulate": "node test/simulate.mjs",
    "test:fuzz": "node test/fuzz.mjs",
    "proofs": "node test/proofs.mjs",
    "proofs:paranoid": "node test/paranoid.mjs",
    "build:bun": "bunx --bun lasm build ServerBun.lean --target bun --output dist/server",
    "start:bun": "bun bun/main.mjs",
    "build:deno": "lasm build ServerDeno.lean --target deno --output dist/server",
    "start:deno": "deno run -A deno/main.mjs",
    "build:workers": "lasm build ServerWorkers.lean --target workers --output dist/server",
    "build:docker": "npm run build && docker build -t tandem ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lasm/cli": "0.3.8",
    "yjs": "13.6.33"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}

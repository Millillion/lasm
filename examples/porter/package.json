{
  "name": "porter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Porter, an OpenID Connect provider in Lean: authorization code flow with PKCE, signed ID tokens, refresh-token rotation, compiled to WebAssembly by Lasm, with proofs",
  "scripts": {
    "build": "lasm build ServerNode.lean --output dist/server",
    "start": "node dist/server/main.mjs",
    "test": "node test/oracles.mjs",
    "test:attacks": "node test/attacks.mjs",
    "test:fuzz": "node test/fuzz.mjs",
    "proofs": "node test/proofs.mjs",
    "proofs:paranoid": "node test/paranoid.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lasm/cli": "0.3.6",
    "jose": "6.2.12",
    "oauth4webapi": "3.8.8",
    "openid-client": "6.8.8"
  },
  "overrides": {
    "jose": "6.2.12"
  }
}

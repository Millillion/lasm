{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Folio, a CommonMark Markdown renderer and static-site generator in Lean, compiled to WebAssembly by Lasm, with proofs",
  "scripts": {
    "build:batch": "lasm build Batch.lean --output dist/batch",
    "test": "node test/spec.mjs",
    "test:differential": "node test/differential.mjs",
    "proofs": "node test/proofs.mjs",
    "proofs:paranoid": "node test/paranoid.mjs",
    "tables": "node tools/tables.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lasm/cli": "0.3.6",
    "commonmark": "0.31.2"
  }
}

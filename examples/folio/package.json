{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Folio, a CommonMark Markdown renderer and static-site generator in Lean, compiled to WebAssembly by Lasm, with proofs",
  "scripts": {
    "build": "lasm build Cli.lean --output dist/cli",
    "build:wasi": "lasm build Cli.lean --target wasi",
    "build:batch": "lasm build Batch.lean --output dist/batch",
    "build:batch-wasi": "lasm build Batch.lean --target wasi --output dist/batch-wasi",
    "build:batch-browser": "lasm build BatchBrowser.lean --target browser --output dist/batch-browser",
    "test": "node test/spec.mjs",
    "test:differential": "node test/differential.mjs",
    "proofs": "node test/proofs.mjs",
    "proofs:paranoid": "node test/paranoid.mjs",
    "tables": "node tools/tables.mjs",
    "test:cli": "node test/cli.mjs --engine node",
    "test:wasi": "node test/cli.mjs --engine node --engine wasmtime --engine wasmer --engine node-wasi",
    "build:preview": "lasm build PreviewClient.lean --target browser --output dist/public",
    "build:server": "npm run build:preview && lasm build PreviewServer.lean --output dist/server",
    "build:bun": "npm run build:preview && bunx --bun lasm build PreviewServer.lean --target bun",
    "build:deno": "npm run build:preview && lasm build PreviewServer.lean --target deno",
    "build:workers": "lasm build ServerEdge.lean --target workers",
    "build:deno-deploy": "lasm build ServerEdge.lean --target deno-deploy",
    "build:fastly": "lasm build ServerEdge.lean --target fastly",
    "test:edge": "node test/edge.mjs",
    "start": "node dist/server/main.mjs",
    "test:e2e": "playwright test -c test/playwright.config.mjs",
    "test:pathological": "node test/pathological.mjs",
    "fuzz": "node test/fuzz.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lasm/cli": "0.5.1",
    "commonmark": "0.31.2",
    "@playwright/test": "1.63.0"
  }
}

{
  "name": "@lasm/compiler",
  "version": "0.3.6",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "examples/express"
  ],
  "type": "module",
  "description": "Lean 4 to WebAssembly compiler for Node, Bun, Deno, edge functions, WASI and the browser",
  "bin": {
    "lasm": "bin/lasm.mjs"
  },
  "exports": {
    "./vite": {
      "types": "./src/vite/index.d.ts",
      "default": "./src/vite/index.mjs"
    },
    "./vite/client": {
      "types": "./src/vite/client.d.ts"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "scripts": {
    "setup": "node scripts/bootstrap.mjs",
    "probe": "node experiments/feasibility/run.mjs",
    "probe:runtime": "node experiments/feasibility/runtime-compile.mjs",
    "probe:bundled-runtime": "node experiments/feasibility/full-bundled-tools.mjs",
    "build:example": "node bin/lasm.mjs build examples/basic/lasm.json",
    "build:io": "node bin/lasm.mjs build examples/io/lasm.json",
    "build:express": "node bin/lasm.mjs build examples/express/lean/lasm.json examples/express/dist",
    "start:express": "npm run start --workspace @lasm/example-express",
    "test:express": "npm run build:express && vitest run --config examples/express/vitest.config.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:lake": "node --test test/lake.test.mjs",
    "test:platform": "node --test test/platform.test.mjs test/portable.test.mjs test/toolchain.test.mjs",
    "test:release": "node --test --test-concurrency=1 integration/release.test.mjs",
    "test:hosts": "node --test --test-concurrency=1 integration/hosts.test.mjs",
    "test:engines": "node --test --test-concurrency=1 integration/engines.test.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:jspi": "node --experimental-wasm-jspi test/io.test.mjs jspi",
    "build:lean-server": "node bin/lasm.mjs build examples/lean-server/Main.lean examples/lean-server/dist",
    "start:lean-server": "node lasm-node.js examples/lean-server/Main.lean",
    "test:lean-server": "vitest run --config examples/lean-server/vitest.config.mjs",
    "test:upstream": "node scripts/upstream-tests.mjs --suite http"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@yarnpkg/cli-dist": "4.18.0",
    "c8": "12.0.0",
    "happy-dom": "21.0.4",
    "miniflare": "5.20260917.0-alpha",
    "playwright-core": "1.63.0",
    "pnpm": "12.4.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "binaryen": "132.0.0",
    "koffi": "3.3.0",
    "tar": "7.5.22"
  }
}

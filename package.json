{
  "name": "@lasm/compiler",
  "version": "0.7.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Lean 4 to WebAssembly compiler for Node, Bun, Deno, edge functions, WASI and the browser",
  "bin": {
    "lasm": "bin/lasm.mjs"
  },
  "exports": {
    "./vite": {
      "types": "./src/vite/index.d.ts",
      "default": "./src/vite/index.mjs"
    },
    "./vite/client": {
      "types": "./src/vite/client.d.ts"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "scripts": {
    "setup": "node scripts/bootstrap.mjs",
    "probe": "node experiments/feasibility/run.mjs",
    "probe:runtime": "node experiments/feasibility/runtime-compile.mjs",
    "test:platform": "node --test test/platform.test.mjs test/portable.test.mjs",
    "test": "node scripts/test/node-test.mjs --test-concurrency=1 test/*.test.mjs",
    "build:lean-server": "node bin/lasm.mjs build examples/lean-server/Main.lean examples/lean-server/dist",
    "start:lean-server": "node lasm-node.js examples/lean-server/Main.lean"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@webref/idl": "3.86.0",
    "c8": "12.0.0",
    "happy-dom": "21.0.4",
    "playwright-core": "1.63.0",
    "webidl2": "24.5.0"
  },
  "dependencies": {
    "koffi": "3.3.0",
    "tar": "7.5.22"
  }
}

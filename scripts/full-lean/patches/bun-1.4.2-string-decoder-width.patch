+      get slice() {
+        events.push("get slice");
+        return function (value) {
+          expect(this).toBe(input);
+          expect(value).toBe(offset);
+          events.push("call slice");
+          return "slice result";
+        };
+      },
+    };
+    expect(decoder.text(input, offset)).toBe("write result");
+    expect(events).toEqual(["get write", "get slice", "call slice", "call write"]);
+  });
+
+  it("keeps a getter-produced write callback alive across slice GC", () => {
+    const decoder = new RealStringDecoder("utf8");

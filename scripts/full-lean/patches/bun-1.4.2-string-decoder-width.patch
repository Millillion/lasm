+describe("StringDecoder.text offset width and reset", () => {
+  it.each([
+    [-4, "abc"], [-2, "bc"], [-1, "c"], [0, "abc"], [1, "bc"], [3, ""],
+    [2 ** 31, ""], [2 ** 32 - 1, ""], [2 ** 32, ""], [2 ** 32 + 1, ""],
+    [Infinity, ""], [-Infinity, "abc"], [NaN, "abc"], [1.9, "bc"], [-1.9, "c"],
+  ])("slices offset %s without narrowing", (offset, expected) => {
+    expect(new RealStringDecoder("utf8").text(Buffer.from("abc"), offset)).toBe(expected);
+  });
+
+  it("accepts an omitted offset", () => {
+    expect(new RealStringDecoder("utf8").text(Buffer.from("abc"))).toBe("abc");
+  });
+
+  it.each([
+    ["utf8", [0xe2, 0x82], Buffer.from("abc"), "abc"],
+    ["utf16le", [0x61], Buffer.from("bc", "utf16le"), "bc"],
+    ["base64", [0x61, 0x62], Buffer.from("abc"), "YWJj"],
+  ])("resets incomplete %s input before text", (encoding, partial, input, expected) => {
+    const decoder = new RealStringDecoder(encoding);
+    expect(decoder.write(Buffer.from(partial))).toBe("");
+    expect(decoder.text(input, 0)).toBe(expected);
+    expect([decoder.lastNeed, decoder.lastTotal]).toEqual([0, 0]);
+  });
+
+  it("resets state before an offset coercion throws", () => {
+    const decoder = new RealStringDecoder("utf8");
+    expect(decoder.write(Buffer.from([0xe2, 0x82]))).toBe("");
+    const error = new Error("offset failed");
+    expect(() => decoder.text(Buffer.from("abc"), {
+      valueOf() {
+        expect([decoder.lastNeed, decoder.lastTotal]).toEqual([0, 0]);
+        throw error;
+      },
+    })).toThrow(error);
+    expect([decoder.lastNeed, decoder.lastTotal]).toEqual([0, 0]);
+  });
+
+  it("preserves public method lookup and callback order", () => {

--- a/tools/link.py
+++ b/tools/link.py
@@ -1684,7 +1684,9 @@
   set_max_memory()
 
   # check if we can address the 2GB mark and higher.
-  if not settings.MEMORY64 and settings.MAXIMUM_MEMORY > 2 * 1024 * 1024 * 1024:
+  # Lowered memory64 still indexes wasm32 memory from JavaScript. Its heap
+  # shifts must be unsigned, just as for ordinary wasm32 above the 2GB mark.
+  if settings.MEMORY64 != 1 and settings.MAXIMUM_MEMORY > 2 * 1024 * 1024 * 1024:
     settings.CAN_ADDRESS_2GB = 1
 
   if settings.MAX_WEBGL_VERSION >= 2:
@@ -2914,6 +2916,10 @@
     # main module to avoid creating new invoke functions at runtime.
     imports = set(imports)
     imports = {i for i in imports if not i.startswith('invoke_')}
+    # Relocation bases belong to each side module and are provided by the
+    # dynamic loader, not exported by the main module's C/JavaScript libraries.
+    imports.difference_update({'__memory_base', '__table_base',
+                               '__memory_base32', '__table_base32'})
     weak_imports = webassembly.get_weak_imports(dylib)
     strong_imports = sorted(imports.difference(weak_imports))
     logger.debug('Adding symbols requirements from `%s`: %s', dylib, imports)

@@ -11,6 +11,13 @@ Authors: Gabriel Ebner, Henrik Böving
 #include "runtime/thread.h"
 
 namespace lean {
+#if defined(LASM_COOPERATIVE_TASKS)
+// One thread: locks never contend between threads. A condition-variable wait
+// lets other queued Lean tasks (or host events) run before returning, so
+// `while !cond do wait` loops make progress (spurious wakeups are allowed).
+extern "C" bool lasm_coop_run_one();
+extern "C" void lasm_coop_block(const char * reason);
+#endif
 
 static lean_external_class * g_basemutex_external_class = nullptr;
 static void basemutex_finalizer(void * h) {
@@ -57,7 +64,11 @@ extern "C" LEAN_EXPORT obj_res lean_io_condvar_new() {
 
 extern "C" LEAN_EXPORT obj_res lean_io_condvar_wait(b_obj_arg condvar, b_obj_arg mtx) {
     unique_lock<mutex> lock(*basemutex_get(mtx), std::adopt_lock_t());
+#if defined(LASM_COOPERATIVE_TASKS)
+    if (!lasm_coop_run_one()) lasm_coop_block("a condition variable wait");
+#else
     condvar_get(condvar)->wait(lock);
+#endif
     lock.release();
     return box(0);
 }

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index ff042a4..852c5b5 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -177,8 +177,16 @@ if(CMAKE_SYSTEM_NAME MATCHES "Emscripten")
   option(LASM_LINK_LAKE "Link Lake into the full Wasm compiler" OFF)
   option(LASM_LINK_TOOLS "Link original Lean tool entry points into Wasm" OFF)
   set(LASM_WASM_LINK_OPTIMIZATION "-O1" CACHE STRING "Wasm link optimization for development iterations")
-  set(EMSCRIPTEN_SETTINGS "-s ALLOW_MEMORY_GROWTH=1 -sMEMORY64=${LASM_MEMORY64} -fwasm-exceptions -pthread")
-  string(APPEND LEANC_EXTRA_CC_FLAGS " -pthread")
+  # Lasm edge profile (Phase 7): Lean's C++ runtime without threads, with
+  # cooperative tasks (runtime/object.cpp LASM_COOPERATIVE_TASKS); configure
+  # with -DMULTI_THREAD=OFF.
+  option(LASM_EDGE "Single-threaded cooperative runtime for edge isolates" OFF)
+  if(LASM_EDGE)
+    set(EMSCRIPTEN_SETTINGS "-s ALLOW_MEMORY_GROWTH=1 -sMEMORY64=${LASM_MEMORY64} -fwasm-exceptions -D LASM_COOPERATIVE_TASKS")
+  else()
+    set(EMSCRIPTEN_SETTINGS "-s ALLOW_MEMORY_GROWTH=1 -sMEMORY64=${LASM_MEMORY64} -fwasm-exceptions -pthread")
+    string(APPEND LEANC_EXTRA_CC_FLAGS " -pthread")
+  endif()
   string(APPEND LEANC_EXTRA_CC_FLAGS " -D LEAN_EMSCRIPTEN ${EMSCRIPTEN_SETTINGS}")
   string(APPEND LEAN_EXTRA_CXX_FLAGS " -D LEAN_EMSCRIPTEN ${EMSCRIPTEN_SETTINGS}")
   string(APPEND LEAN_EXTRA_LINKER_FLAGS " ${EMSCRIPTEN_SETTINGS}")

diff --git a/src/runtime/lasm-sdk-mimalloc.cpp b/src/runtime/lasm-sdk-mimalloc.cpp
new file mode 100644
index 0000000..95c03ad
--- /dev/null
+++ b/src/runtime/lasm-sdk-mimalloc.cpp
@@ -0,0 +1,25 @@
+/*
+Lasm: allocation entry points for builds that link Emscripten's mimalloc
+(LASM_SDK_MIMALLOC). Upstream `mimalloc.cpp` compiles Lean's own mimalloc copy
+into the runtime; here the SDK supplies the allocator, so only the symbols the
+rest of the runtime and `lean.h` expect are defined, with the same observable
+behavior as Lean 4.34's inline `lean_alloc_small_object`: one heartbeat per
+small allocation, `mi_malloc_small`, and the exact aligned size in `m_cs_sz`.
+*/
+#include <lean/lean.h>
+#include "runtime/alloc.h"
+#include "runtime/debug.h"
+
+extern "C" __thread lean_runtime_tls lean_g_tls = { 0, nullptr };
+
+extern "C" void lean_mi_theap_cache_init(void) {}
+
+extern "C" LEAN_EXPORT LEAN_ATTR_MALLOC lean_object * lean_alloc_small_object_core(unsigned sz) {
+    lean_g_tls.heartbeat++;
+    lean_assert(sz > 0 && sz % LEAN_OBJECT_SIZE_DELTA == 0 && sz <= MI_SMALL_SIZE_MAX);
+    void * mem = mi_malloc_small(sz);
+    if (LEAN_UNLIKELY(mem == NULL)) lean_internal_panic_out_of_memory();
+    lean_object * o = (lean_object *)mem;
+    o->m_cs_sz = sz;
+    return o;
+}

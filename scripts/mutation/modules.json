{
  "comment": "Mutation-testing modules (docs/TESTING.md#mutation-testing). Each module mutates `mutate` and runs `tests` (node:test files that need no managed Lean or native helpers). Each module's recorded score and its threshold (the ratchet) are in docs/evidence/mutation-baseline.json.",
  "modules": [
    {
      "name": "host-bridge",
      "description": "Lasm.JS host bridge on Node: sync callbacks, the doorbell wait and mailbox, completion polling, value marshalling",
      "mutate": ["src/node-js.mjs"],
      "tests": ["test/node-js.test.mjs", "test/node-js-bridge.test.mjs"]
    },
    {
      "name": "ui-dom",
      "description": "Lasm.UI DOM applier and patch decoder (lasm:ui-dom)",
      "mutate": ["src/lasm-modules/ui-dom.mjs"],
      "tests": ["test/ui-dom.test.mjs", "test/ui-dom-applier.test.mjs"]
    },
    {
      "name": "build-service",
      "description": "lasm dev build workers, the build client, output receipts and cache reuse checks, the cache lease",
      "mutate": ["src/dev-build-service.mjs", "src/application-build-client.mjs", "src/application-files.mjs", "src/cache-lifecycle.mjs"],
      "tests": ["test/dev-build-service.test.mjs", "test/build-progress.test.mjs", "test/application-files.test.mjs", "test/application-files-faults.test.mjs", "test/cache-lifecycle.test.mjs", "test/build-cache-files.test.mjs"]
    },
    {
      "name": "link-driver",
      "description": "The Node link driver: object compile plans, Wasm linking, glue generation, link metadata",
      "mutate": ["src/link-driver/link.mjs", "src/link-driver/glue.mjs", "src/link-driver/wasm.mjs", "src/link-driver/metadata.mjs", "src/link-driver/settings.mjs", "src/link-driver/compile.mjs"],
      "tests": ["test/link-driver-link.test.mjs", "test/link-driver-pipeline.test.mjs", "test/link-driver-recipe.test.mjs", "test/link-driver-glue.test.mjs", "test/link-driver-wasm.test.mjs", "test/link-driver-compile.test.mjs", "test/dev-loop.test.mjs"]
    },
    {
      "name": "target-link",
      "description": "Application, edge and WASI linking (src/*link*.mjs)",
      "mutate": ["src/application-link.mjs", "src/edge/edge-link.mjs", "src/wasi/wasi-link.mjs"],
      "tests": ["test/application-link-glue.test.mjs", "test/application-object-store.test.mjs", "test/full-application-link-mode.test.mjs", "test/link-driver-compile.test.mjs", "test/edge.test.mjs", "test/wasi.test.mjs",
        "test/application-link-plan.test.mjs", "test/application-link-node.test.mjs", "test/edge-link-plan.test.mjs", "test/wasi-link-plan.test.mjs"]
    },
    {
      "name": "edge-glue",
      "description": "Edge runtime glue: the edge host, Lasm.JS on the edge, the runtime loader and start-up",
      "mutate": ["src/edge/edge-host.mjs", "src/edge/edge-js.mjs", "src/edge/edge-runtime.mjs", "src/edge/edge-start.mjs"],
      "tests": ["test/edge.test.mjs", "test/edge-js.test.mjs", "test/edge-host.test.mjs", "test/edge-runtime.test.mjs"]
    },
    {
      "name": "notices",
      "description": "Licence and third-party notice generation",
      "mutate": ["src/notices.mjs"],
      "tests": ["test/notices.test.mjs", "test/notices-targets.test.mjs", "test/application-output.test.mjs", "test/managed-artifacts.test.mjs", "test/npm-dist-packages.test.mjs"]
    }
  ]
}

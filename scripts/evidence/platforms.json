{
  "about": "Evidence levels per platform (docs/TESTING.md#evidence-levels), derived by scripts/evidence/levels.mjs from the latest completed main-branch run of each workflow (release-* branches count: release PRs merge into main and are where release-checks runs its full set). Each requirement names a workflow file and a job-name pattern; it holds when every matching job of the newest run that has one succeeded, within maxAgeDays. A platform's level is the highest level whose requirements, and all lower levels', hold. null: no CI job gives this kind of evidence for the platform yet. Differential tests compare the compiled program, so a platform counts the differential results of the build it runs (node, edge, wasi, or its own target: bun, browser-chromium on every run, browser-firefox and browser-webkit in campaigns); conformance is the platform's own run of an outside suite (the official RealWorld API suite through Conduit).",
  "maxAgeDays": 30,
  "levels": {
    "L0": "It builds",
    "L1": "Its smoke tests pass",
    "L2": "Its output matches Node's across the differential tests, and the platform's own conformance suites pass",
    "L3": "A full example app also passes an independent test suite, plus fuzzing and simulation"
  },
  "platforms": [
    {
      "id": "node",
      "row": "Node.js 24+",
      "L0": [{ "workflow": "release-checks.yml", "job": "^candidate / platform / build on " }],
      "L1": [{ "workflow": "release-checks.yml", "job": "^candidate / templates / templates " },
             { "workflow": "release-checks.yml", "job": "^candidate / (linux|darwin|windows)-[a-z0-9]+ / installed$" }],
      "L2": [{ "workflow": "differential.yml", "job": "^differential \\(release\\)$" },
             { "workflow": "differential.yml", "job": "^equivalence \\(" },
             { "workflow": "conduit.yml", "job": "^API on Node " }],
      "L3": [{ "workflow": "conduit.yml", "job": "^(API|E2E) on Node" },
             { "workflow": "ledger.yml", "job": "^Differential test against TigerBeetle" },
             { "workflow": "folio-nightly.yml", "job": "^fuzz$" },
             { "workflow": "porter-nightly.yml", "job": "^40 minutes of fuzzing$" },
             { "workflow": "bridge-verification.yml", "job": "^(model|fuzz / stress \\(ubuntu-24\\.04, linux-x64\\))$" }]

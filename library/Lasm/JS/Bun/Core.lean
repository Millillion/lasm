  let fn ← Lasm.JS.Function.ofSyncFn fun args => do return toJS (← f (← Internal.arg Data args 0) (← Internal.arg Data args 1))
  let _ : Value ← (← (← Lasm.JS.global).get "Object" Value).callMethod "defineProperty"

@[match_pattern] abbrev CSSMathOperator.negate : CSSMathOperator := .unsafeOfString "negate"
/-- "invert" -/
@[match_pattern] abbrev CSSMathOperator.invert : CSSMathOperator := .unsafeOfString "invert"
/-- "min" -/
@[match_pattern] abbrev CSSMathOperator.min : CSSMathOperator := .unsafeOfString "min"
/-- "max" -/
@[match_pattern] abbrev CSSMathOperator.max : CSSMathOperator := .unsafeOfString "max"
/-- "clamp" -/
@[match_pattern] abbrev CSSMathOperator.clamp : CSSMathOperator := .unsafeOfString "clamp"
instance : ToJS CSSMathOperator := ⟨fun x => .string x.val⟩
instance : FromJS CSSMathOperator where
  fromJS
    | .string s => .ok (.unsafeOfString s)
    | _ => .error "not a string"
  typeName := "Lasm.JS.Web.CSSMathOperator"

end Lasm.JS.Web

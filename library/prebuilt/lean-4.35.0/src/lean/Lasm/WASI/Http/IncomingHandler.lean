import Lasm.WASI.Http.Types

namespace Lasm.WASI.Http.IncomingHandler
open Lasm.WASI.Http.Types

/-- The arguments of this instance's `handle(request: incoming-request, response-out: response-outparam)`
call (WIT: `wasi:http/incoming-handler@0.2.12#handle`), which runs the program's `main`
once per request: the request and the outparam its response goes to, both owned by
the program. Fails when they were taken already, and when the program is not a
`lasm build --target wasi-http` component. If `main` returns without taking
them, the host gets a 500 response. -/
@[extern "lasm_wasi_http_incoming_handler_take"]
opaque take : IO (IncomingRequest × ResponseOutparam)

/-- Serves this instance's request: `main := IncomingHandler.serve fun request responseOut => …`.
The handler answers through `ResponseOutparam.set responseOut (.ok response)`. -/
def serve (handler : IncomingRequest → ResponseOutparam → IO Unit) : IO Unit := do
  let (request, responseOut) ← take
  handler request responseOut

end Lasm.WASI.Http.IncomingHandler

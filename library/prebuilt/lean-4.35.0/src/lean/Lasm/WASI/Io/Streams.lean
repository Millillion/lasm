opaque OutputStream.flush (self : OutputStream) : IO (Except StreamError Unit)

/-- Request to flush buffered output, and block until flush completes
and stream is ready for writing again.

WIT: `[method]output-stream.blocking-flush` (`wasi:io/streams@0.2.12`) -/
@[extern "lasm_wasi_io_streams_output_stream_blocking_flush"]
opaque OutputStream.blockingFlush (self : OutputStream) : IO (Except StreamError Unit)

/-- Create a `pollable` which will resolve once the output-stream

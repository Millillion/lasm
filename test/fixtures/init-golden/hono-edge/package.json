{
  "name": "edge-app",
  "version": "0.1.0",
  "private": true,
  "description": "Hono on @hono/node-server with Lean request handlers (Lasm.JS), compiled to WebAssembly by Lasm",
  "scripts": {
    "dev": "lasm dev Main.lean",
    "build": "lasm build Main.lean",
    "start": "node dist/main.mjs",
    "build:workers": "lasm build Main.lean --target workers",
    "build:vercel-edge": "lasm build Main.lean --target vercel-edge",
    "build:netlify-edge": "lasm build Main.lean --target netlify-edge",
    "build:deno-deploy": "lasm build Main.lean --target deno-deploy",
    "build:supabase-edge": "lasm build Main.lean --target supabase-edge",
    "dev:bun": "bun x --bun lasm dev Main.lean",
    "build:bun": "bun x --bun lasm build Main.lean --target bun",
    "start:bun": "bun bun/main.mjs",
    "build:deno": "lasm build Main.lean --target deno",
    "start:deno": "deno run -A deno/main.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "lasm": {
    "edge": {
      "exclude": [
        "@hono/node-server"
      ]
    }
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@lasm/compiler": "<LASM_VERSION>"
  }
}

{
  "name": "fetch.app",
  "version": "0.1.0",
  "private": true,
  "description": "an HTTP handler in pure Lean (Lasm.Fetch) for Node, Fastly Compute, WASI, Spin and the edge, compiled to WebAssembly by Lasm",
  "scripts": {
    "dev": "lasm dev Main.lean",
    "build": "lasm build Main.lean",
    "start": "node dist/main.mjs",
    "build:fastly": "lasm build Main.lean --target fastly",
    "build:wasi": "lasm build Main.lean --target wasi",
    "build:wasi-http": "lasm build Main.lean --target wasi-http",
    "build:workers": "lasm build Main.lean --target workers",
    "start:spin": "spin up",
    "start:fastly": "fastly compute serve",
    "dev:bun": "bun x --bun lasm dev Main.lean",
    "build:bun": "bun x --bun lasm build Main.lean --target bun",
    "start:bun": "bun bun/main.mjs",
    "build:deno": "lasm build Main.lean --target deno",
    "start:deno": "deno run -A deno/main.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lasm/compiler": "<LASM_VERSION>"
  }
}

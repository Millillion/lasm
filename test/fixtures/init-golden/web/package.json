{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "a browser app in Lean (Lasm.UI): a counter, compiled to WebAssembly by Lasm",
  "scripts": {
    "dev": "lasm dev Main.lean --target browser",
    "build": "lasm build Main.lean --target browser",
    "preview": "lasm dev Main.lean --target browser --release"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lasm/compiler": "<LASM_VERSION>"
  }
}

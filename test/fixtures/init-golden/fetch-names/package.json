{
  "name": "a..b-2_",
  "version": "0.1.0",
  "private": true,
  "description": "an HTTP handler on the web's Request and Response (Lasm.JS.Web) for Node, the edge, Bun and Deno, and on Fastly Compute, WASI and Spin through their own interfaces, compiled to WebAssembly by Lasm",
  "scripts": {
    "dev": "lasm dev Main.lean",
    "build": "lasm build Main.lean",
    "start": "node dist/main.mjs",
    "build:fastly": "lasm build Fastly.lean --target fastly",
    "build:wasi-http": "lasm build WasiHttp.lean --target wasi-http",
    "start:spin": "spin up",
    "start:fastly": "fastly compute serve",
    "dev:bun": "bun x --bun lasm dev Main.lean",
    "build:bun": "bun x --bun lasm build Main.lean --target bun",
    "start:bun": "bun bun/main.mjs",
    "build:deno": "lasm build Main.lean --target deno",
    "start:deno": "deno run -A deno/main.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lasm/compiler": "<LASM_VERSION>"
  }
}

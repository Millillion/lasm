# The Lasm.JS wire format: one tag byte per value (library/Lasm/JS/Core.lean, Wire),
# then u32 lengths and u64 numbers, little-endian.
undefined="\x00"
null="\x01"
false="\x02"
true="\x03"
number="\x04"
string="\x05"
bigint="\x06"
bytes="\x07"
array="\x08"
object="\x09"
ref="\x0a"
len0="\x00\x00\x00\x00"
len1="\x01\x00\x00\x00"
lenmax="\xff\xff\xff\xff"
nan="\x00\x00\x00\x00\x00\x00\xf8\x7f"
minus="-"
zero="0"

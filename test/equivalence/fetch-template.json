{
  "app": "fetch-template",
  "description": "The fetch template (lasm init --template fetch) on every server target. Recorded from node with --record; see docs/TESTING.md#target-equivalence.",
  "readyPath": "/health",
  "requests": [
    {
      "name": "root",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "hello-ascii",
      "method": "GET",
      "path": "/hello/Ada"
    },
    {
      "name": "hello-utf8",
      "method": "GET",
      "path": "/hello/%E2%9C%93%F0%9F%98%80"
    },
    {
      "name": "hello-space",
      "method": "GET",
      "path": "/hello/a%20b"
    },
    {
      "name": "hello-encoded-slash",
      "method": "GET",
      "path": "/hello/a%2Fb"
    },
    {
      "name": "hello-quote-backslash",
      "method": "GET",
      "path": "/hello/%22q%5C"
    },
    {
      "name": "hello-plus",
      "method": "GET",
      "path": "/hello/a+b"
    },
    {
      "name": "hello-trailing-slash",
      "method": "GET",
      "path": "/hello/Ada/"
    },
    {
      "name": "hello-query",
      "method": "GET",
      "path": "/hello/Ada?x=1"
    },
    {
      "name": "double-slash",
      "method": "GET",
      "path": "//"
    },
    {
      "name": "dot-segments",
      "method": "GET",
      "path": "/hello/../hello/Ada"
    },
    {
      "name": "echo-text",
      "method": "POST",
      "path": "/echo",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      },
      "body": "héllo, wörld 😀\n"
    },
    {
      "name": "echo-binary",
      "method": "POST",
      "path": "/echo",
      "headers": {
        "content-type": "application/octet-stream"
      },
      "bodyBase64": ""
    },
    {
      "name": "echo-no-type",
      "method": "POST",
      "path": "/echo",
      "body": "x"
    },
    {
      "name": "echo-empty",
      "method": "POST",
      "path": "/echo",
      "headers": {
        "content-type": "text/plain"
      },
      "body": ""
    },
    {
      "name": "echo-256k",
      "method": "POST",
      "path": "/echo",
      "headers": {
        "content-type": "text/plain"
      },
      "bodyRepeat": {
        "text": "0123456789abcdef",
        "times": 16384
      }
    },
    {
      "name": "health",
      "method": "GET",
      "path": "/health"
    },
    {
      "name": "not-found",
      "method": "GET",
      "path": "/nope"
    },
    {
      "name": "wrong-method",
      "method": "DELETE",
      "path": "/"
    },
    {
      "name": "put-echo",
      "method": "PUT",
      "path": "/echo",
      "body": "x"
    },
    {
      "name": "head-root",
      "method": "HEAD",
      "path": "/"
    }
  ]
}

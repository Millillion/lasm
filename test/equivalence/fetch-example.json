{
  "app": "fetch-example",
  "description": "examples/fetch (Lasm.Fetch) on every server target. Recorded from node with --record; see docs/TESTING.md#target-equivalence.",
  "readyPath": "/",
  "requests": [
    {
      "name": "root",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "hello-ascii",
      "method": "GET",
      "path": "/hello/Ada"
    },
    {
      "name": "hello-utf8",
      "method": "GET",
      "path": "/hello/%E2%9C%93%F0%9F%98%80"
    },
    {
      "name": "hello-space",
      "method": "GET",
      "path": "/hello/a%20b"
    },
    {
      "name": "hello-encoded-slash",
      "method": "GET",
      "path": "/hello/a%2Fb"
    },
    {
      "name": "hello-quote-backslash",
      "method": "GET",
      "path": "/hello/%22q%5C"
    },
    {
      "name": "hello-plus",
      "method": "GET",
      "path": "/hello/a+b"
    },
    {
      "name": "hello-trailing-slash",
      "method": "GET",
      "path": "/hello/Ada/"
    },
    {
      "name": "hello-query",
      "method": "GET",
      "path": "/hello/Ada?x=1"
    },
    {
      "name": "double-slash",
      "method": "GET",
      "path": "//"
    },
    {
      "name": "dot-segments",
      "method": "GET",
      "path": "/hello/../hello/Ada",
      "known": {
        "targets": [
          "bun",
          "workers"
        ],
        "issue": "https://github.com/Millillion/lasm/issues/27"
      }
    },
    {
      "name": "echo-text",
      "method": "POST",
      "path": "/echo",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      },
      "body": "héllo, wörld 😀\n"
    },
    {
      "name": "echo-binary",
      "method": "POST",
      "path": "/echo",
      "headers": {
        "content-type": "application/octet-stream"
      },
      "bodyBase64": ""
    },
    {
      "name": "echo-no-type",
      "method": "POST",
      "path": "/echo",
      "body": "x"
    },
    {
      "name": "echo-empty",
      "method": "POST",
      "path": "/echo",
      "headers": {
        "content-type": "text/plain"
      },
      "body": ""
    },
    {
      "name": "echo-256k",
      "method": "POST",
      "path": "/echo",
      "headers": {
        "content-type": "text/plain"
      },
      "bodyRepeat": {
        "text": "0123456789abcdef",
        "times": 16384
      }
    },
    {
      "name": "not-found",
      "method": "GET",
      "path": "/nope"
    },
    {
      "name": "wrong-method",
      "method": "DELETE",
      "path": "/"
    },
    {
      "name": "put-echo",
      "method": "PUT",
      "path": "/echo",
      "body": "x"
    },
    {
      "name": "head-root",
      "method": "HEAD",
      "path": "/"
    },
    {
      "name": "fib-10",
      "method": "GET",
      "path": "/fib/10"
    },
    {
      "name": "fib-cap",
      "method": "GET",
      "path": "/fib/99"
    },
    {
      "name": "fib-bad",
      "method": "GET",
      "path": "/fib/abc"
    },
    {
      "name": "primes",
      "method": "GET",
      "path": "/primes/100000"
    },
    {
      "name": "bignum",
      "method": "GET",
      "path": "/bignum"
    },
    {
      "name": "query",
      "method": "GET",
      "path": "/query?a=1&b=2&a=3"
    },
    {
      "name": "query-encoded",
      "method": "GET",
      "path": "/query?x=%C3%A9&empty=&flag&p=a+b&q=%2B%26%3D"
    },
    {
      "name": "words",
      "method": "POST",
      "path": "/words",
      "headers": {
        "content-type": "text/plain"
      },
      "body": "the cat and the hat and the bat"
    },
    {
      "name": "headers",
      "method": "GET",
      "path": "/headers",
      "headers": {
        "x-lasm-test": "value with spaces, and \"quotes\""
      }
    },
    {
      "name": "status-201",
      "method": "GET",
      "path": "/status/201"
    },
    {
      "name": "status-418",
      "method": "GET",
      "path": "/status/418"
    },
    {
      "name": "status-bad",
      "method": "GET",
      "path": "/status/abc"
    },
    {
      "name": "redirect",
      "method": "GET",
      "path": "/redirect"
    },
    {
      "name": "empty",
      "method": "GET",
      "path": "/empty"
    },
    {
      "name": "asleep",
      "method": "GET",
      "path": "/asleep/20"
    },
    {
      "name": "sleep",
      "method": "GET",
      "path": "/sleep/20"
    },
    {
      "name": "tasks",
      "method": "GET",
      "path": "/tasks"
    },
    {
      "name": "env",
      "method": "GET",
      "path": "/env/LASM_EQ_VALUE",
      "skip": [
        "wasi-http"
      ],
      "note": "wasi:http/proxy has no environment (docs/WASI.md)"
    },
    {
      "name": "env-missing",
      "method": "GET",
      "path": "/env/LASM_EQ_NOT_SET"
    },
    {
      "name": "time",
      "method": "GET",
      "path": "/time"
    },
    {
      "name": "throw",
      "method": "GET",
      "path": "/throw"
    },
    {
      "name": "stream-out",
      "method": "GET",
      "path": "/stream/out/5"
    },
    {
      "name": "stream-in",
      "method": "POST",
      "path": "/stream/in",
      "headers": {
        "content-type": "application/octet-stream"
      },
      "bodyRepeat": {
        "text": "x",
        "times": 100000
      }
    },
    {
      "name": "stream-echo",
      "method": "POST",
      "path": "/stream/echo",
      "headers": {
        "content-type": "text/plain"
      },
      "bodyRepeat": {
        "text": "stream ",
        "times": 10000
      }
    }
  ]
}

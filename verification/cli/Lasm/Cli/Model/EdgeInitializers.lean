/-
# src/edge/edge-initializers.mjs, in Lean

A model of the JavaScript, written to mirror it function for function, and
checked against it on generated plans by test/models/cli-differential.mjs
(the `cli-models` workflow).

| src/edge/edge-initializers.mjs                 | here                              |
| ---------------------------------------------- | --------------------------------- |
| `calls[unit] ?? []`                            | `edgesOf calls unit`              |
| `initializationSchedule(name, calls, keep)`    | `initializationSchedule`, `visit` |
| the initializer-name pattern of `compactInitializerWrappers` | `validInitializer`  |
| `compactInitializerWrappers(plan)`             | `compactInitializerWrappers`      |

Reading guide. A plan's `calls` is a JavaScript object from an initializer
to the initializers it calls, read as its entries (each key once); `keep` is
a `Set`, read as a list. The JavaScript's walk ends because every unit is
visited once; the model's `visit` carries fuel instead, and
`initializationSchedule` gives it the number of entries plus one: along any
chain of nested visits the units are distinct (each is added to `seen` before
its calls are visited) and all but the last have an entry, so the fuel never
runs out. Outside the model: an initializer named like a property of
`Object.prototype` (`constructor`, `__proto__`), which `calls[unit]` would
find; initializer names are C identifiers that start with `initialize_`,
`runtime_` or `meta_`.
-/

namespace Lasm.Cli

/-- `calls[unit] ?? []`: the initializers a unit calls, in order. -/
def edgesOf (calls : List (String × List String)) (unit : String) : List String :=
  (calls.lookup unit).getD []

/-- `visit(unit)` with its state (`seen`, `order`): a unit not yet seen is
marked, its calls are visited in order, and then, when kept, it is appended
to `order`. -/
def visit (calls : List (String × List String)) (keep : List String) :
    Nat → List String × List String → String → List String × List String
  | 0, st, _ => st
  | fuel + 1, (seen, order), unit =>
    if unit ∈ seen then (seen, order)
    else
      let after := (edgesOf calls unit).foldl (visit calls keep fuel) (unit :: seen, order)
      (after.1, if unit ∈ keep then after.2 ++ [unit] else after.2)

/-- `initializationSchedule(name, calls, keep)`: the kept initializers reached
from `name`'s calls, in the order the chains initialize them (`seen` starts
with `name`). -/
def initializationSchedule (name : String) (calls : List (String × List String)) (keep : List String) : List String :=
  ((edgesOf calls name).foldl (visit calls keep (calls.length + 1)) ([name], [])).2

/-- An initialization plan as `compactInitializerWrappers` reads it (after
its shape check: `schema` 1, arrays `closure` and `keep`, an object `calls`). -/
structure Plan where
  closure : List String
  keep : List String
  calls : List (String × List String)

/-- The edges of a plan. -/
def Plan.edges (p : Plan) : String → List String := edgesOf p.calls

/-- `/^(?:runtime_|meta_)?initialize_[A-Za-z0-9_]+$/`. -/
def validInitializer (n : String) : Bool :=
  let word := fun (s : List Char) => !s.isEmpty && s.all fun c => c.isAlphanum || c = '_'
  let rest := fun (s : List Char) => match s.splitAt 11 with
    | (p, w) => p == "initialize_".toList && word w
  rest n.toList || (n.toList.take 8 == "runtime_".toList && rest (n.toList.drop 8)) ||
    (n.toList.take 5 == "meta_".toList && rest (n.toList.drop 5))

/-- The lines of the wrapper of a kept initializer. -/
def keptWrapper (p : Plan) (name : String) : String :=
  let schedule := initializationSchedule name p.calls p.keep
  String.intercalate "\n" <|
    [s!"lean_object* __wrap_{name}(uint8_t builtin) \{", "  static bool done = false;",
      "  if (done) return lean_io_result_mk_ok(lean_box(0));", "  done = true;"] ++
    (if schedule.isEmpty then [] else ["  lean_object* res;"]) ++
    schedule.map (fun unit => s!"  res = __wrap_{unit}(builtin); if (lean_io_result_is_error(res)) return res; lean_dec_ref(res);") ++
    [s!"  return __real_{name}(builtin);", "}"]

/-- `compactInitializerWrappers(plan)`: the C source, or the message it throws
on a closure name that is not an initializer's. -/
def compactInitializerWrappers (p : Plan) : Except String String :=
  match p.closure.find? (!validInitializer ·) with
  | some n => .error s!"Unexpected initializer name {n}"
  | none =>
    let lines := ["// Generated by Lasm: compact runtime initialization (src/edge/edge-initializers.mjs).",
      "#include <lean/lean.h>", "#include <stdbool.h>",
      "lean_object* lasm_initializer_skip(uint8_t builtin) { (void)builtin; return lean_io_result_mk_ok(lean_box(0)); }"] ++
      p.closure.flatMap (fun name =>
        if name ∈ p.keep then [s!"lean_object* __real_{name}(uint8_t);", s!"lean_object* __wrap_{name}(uint8_t);"]
        else [s!"lean_object* __wrap_{name}(uint8_t) __attribute__((alias(\"lasm_initializer_skip\")));"]) ++
      (p.closure.filter (· ∈ p.keep)).map (keptWrapper p)
    .ok (String.intercalate "\n" lines ++ "\n")

end Lasm.Cli
